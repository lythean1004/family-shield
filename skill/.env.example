# 스킬 서버 환경 변수 예시. 실제 값은 절대 커밋하지 않는다.
# 운영: /etc/family-shield/skill.env (root 소유, 600) + systemd EnvironmentFile
# 개발: .env.skill.local (커밋 금지) + node --env-file=.env.skill.local

# 카카오 오픈빌더 스킬 헤더 토큰 (필수)
SKILL_HEADER_TOKEN=changeme

# aitestbed.kr 중계 서버 API 키 (필수)
AI_API_KEY=changeme

# 중계 서버 전체 주소. 비우면 ai-client.js 기본값 사용
AI_BASE_URL=https://gateway.aitestbed.kr/v1/chat/completions

# 채널별 모델 (D30): 카카오는 gemini-3.1-flash-lite
AI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=3000
PROMPT_VERSION=v1

# 바인딩 (Nginx가 443을 받아 127.0.0.1:3000으로 프록시)
SKILL_HOST=127.0.0.1
SKILL_PORT=3000

# 번호 HMAC 키. 없으면 마스킹은 하되 HMAC은 생략
PHONE_HMAC_SECRET=changeme
MAX_CONCURRENT=8

# 웹(PWA) 주소. 자세히 보기 버튼에 쓴다. 없으면 null
WEB_BASE_URL=https://family-shield.example.kr

