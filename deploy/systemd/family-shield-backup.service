[Unit]
Description=Family Shield: nightly DB backup (pg_dump, 7 days kept)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=fsops
Group=fsops
EnvironmentFile=/etc/family-shield/skill.env
# Stop immediately if purge or dump fails; publish only complete, owner-only dumps.
ExecStart=/usr/bin/bash /srv/family-shield/repo/deploy/remote/db-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/family-shield/backup
