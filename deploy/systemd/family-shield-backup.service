[Unit]
Description=Family Shield: nightly DB backup (pg_dump, 7 days kept)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=fsops
Group=fsops
EnvironmentFile=/etc/family-shield/skill.env
# custom format, owner-only file. Run purge in the same shell first so backups hold at most 24h of checks.
ExecStart=/usr/bin/bash -c 'umask 077; export PGPASSWORD="$DATABASE_PASSWORD"; c="-h $DATABASE_HOST -p $DATABASE_PORT -U $DATABASE_USER -d $DATABASE_NAME"; /usr/bin/psql -X -q -A -t -v ON_ERROR_STOP=1 $c -c "begin; set local role service_role; select count(*) from private.purge_expired(); commit;" >/dev/null && d=/srv/family-shield/backup; f="$d/familyshield-$(date +%%Y%%m%%d-%%H%%M).dump"; /usr/bin/pg_dump -Fc $c -f "$f" && find "$d" -name "familyshield-*.dump" -mtime +7 -delete && ls -l "$f"'
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/family-shield/backup
